# Copy to .env.local for local development, and add the same values under
# Settings -> Environment Variables in Vercel for deployments.

# Required to enable the "Ask about your stats" assistant.
# Create one at https://openrouter.ai/keys
#
# NOTE: the /api/chess/[username]/chat endpoint is public and unauthenticated,
# so anyone who finds your deployed URL can spend credits on this key. Set a
# spend limit on it in the OpenRouter dashboard.
OPENROUTER_API_KEY=

# Optional. Defaults to google/gemma-4-31b-it.
# Try google/gemma-4-31b-it:free for zero-cost local testing (lower rate limits).
OPENROUTER_MODEL=

# Optional. Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# Optional. Sent as OpenRouter attribution headers so requests show up
# against your app on openrouter.ai.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
